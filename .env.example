# AI root-cause analysis. Provider order: Groq (primary) -> Gemini (secondary) -> built-in rules.
# Set either, both, or neither; the app always works.
GROQ_API_KEY=         # free: console.groq.com/keys
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=        # free: aistudio.google.com
GEMINI_MODEL=gemini-2.5-flash

# Voice + Telegram alerts (all optional; the dashboard works without them)
# Spoken alerts reuse GROQ_API_KEY above (Groq Orpheus text-to-speech). If it is missing or rate-limited the browser's built-in voice is used.
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=autumn    # autumn, diana, hannah, austin, daniel, troy
# Telegram: create a bot with @BotFather (token), message your bot once, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id":...}
TELEGRAM_BOT_TOKEN= 
TELEGRAM_CHAT_ID=  

# Company sign-in. AUTH_SECRET: any random string of 32+ characters. AUTH_USERS: username:password pairs separated by commas.
AUTH_SECRET= 
AUTH_USERS= 

# Neon Postgres (Vercel Storage > Neon adds this automatically)
DATABASE_URL=
